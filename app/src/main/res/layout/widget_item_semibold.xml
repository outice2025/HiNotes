<?xml version="1.0" encoding="utf-8"?>
<!--
  One chunk of the note's body at the semibold weight; see widget_item_light.xml for why there is
  one layout per weight, and why a chunk is a row with a box in it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_chunk"
        style="@style/WidgetBody.SemiBold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:lineSpacingExtra="4dp"
        android:lineSpacingMultiplier="1.4"
        android:textColor="#FF000000"
        android:textSize="14sp" />

</LinearLayout>
