<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's card: a rounded surface carrying the note's title and its scrolling body.

  The surface is a view of its own rather than the root's own background, because that is what lets
  the card keep its rounded corners on every version the app supports (see HiNotesWidgetProvider).
  Every colour here is written again at runtime from the app's own colour scheme (see
  WidgetStyle.kt), so the values below are only the state before the first drawing arrives - which
  is a moment, because the card is drawn as soon as it is placed (see HiNotesWidgetProvider). The
  title is not part of the widget's type setting: the app's own note font settings apply to note
  content, and a card's title is drawn in the card's own style.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
      The card's fill, stretched to whatever size the card is placed at: a shape has no intrinsic
      size, so the corners keep the radius the app's own large surfaces use rather than being scaled
      with the card. It is decoration, so it is kept out of the accessibility tree.
    -->
    <ImageView
        android:id="@+id/widget_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!--
          The title carries the app's name until the first drawing arrives: on Android 12 and later
          this very layout is what the widget picker previews, and an empty card would preview as a
          blank. The note's own title replaces it the moment the widget is placed.
        -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="#FF000000"
            android:textSize="16sp" />

        <!--
          The body is a collection, not a scrolling view: see HiNotesWidgetService. The scrollbar is
          switched off, so the text simply continues as the user swipes; the divider is removed so
          the chunks read as one note rather than as a list of them.
        -->
        <ListView
            android:id="@android:id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

    </LinearLayout>

</FrameLayout>
